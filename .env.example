# Default fallback model
MODEL=openrouter/openrouter/free

# API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Separate API Key for Validation Pipeline (Candidate Simulator & Judge)
GEMINI_VALIDATION_API_KEY=your_second_gemini_api_key_here

# Individual Agent Models (CrewAI Pipeline)
MODEL_CV_PARSER=gemini-3.5-flash-lite
MODEL_JOB_PARSER=gemini-3.5-flash-lite
MODEL_CV_REVIEWER=gemini-3.5-flash-lite
MODEL_CV_OPTIMIZER=gemini-3.5-flash-lite
MODEL_CV_GENERATOR=gemini-3.5-flash-lite

# Validation Pipeline Models (Simulator & Judge)
MODEL_CANDIDATE=gemini-3.5-flash-lite
MODEL_JUDGE=gemini-3.5-flash-lite
